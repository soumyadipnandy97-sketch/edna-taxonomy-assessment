# Server-side AI & Application URL (automatically injected in AI Studio)
GEMINI_API_KEY=
APP_URL=

# Optional server-side admin bootstrap passcode (leave empty to use first-run setup or Google Admin sign-in)
ADMIN_BOOTSTRAP_PASSCODE=

# Optional external Supabase integration (PostgreSQL & Auth run natively via provisioned Cloud SQL + Firebase Auth)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Firebase web analytics overrides (default values loaded from firebase-applet-config.json)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
